<ui:FluentWindow x:Class="SolarNX.UI.Library.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Edit.Game}" Width="720" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="#FF0B0B14">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="{DynamicResource Edit.Game}" Height="42" Background="Transparent" Foreground="White"
                     ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" Margin="20,8,20,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Edit.Name}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Grid.Column="1" Padding="6" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Edit.LaunchType}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TypeCombo" Grid.Column="1" />
                    </Grid>

                    <!-- Обычная игра -->
                    <StackPanel x:Name="NativePanel">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Edit.GameExe}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExePathBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseExeButton" Grid.Column="2" Content="{DynamicResource Common.Browse}" Appearance="Secondary" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Edit.Arguments}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ArgumentsBox" Grid.Column="1" Padding="6" />
                        </Grid>
                    </StackPanel>

                    <!-- Steam -->
                    <StackPanel x:Name="SteamPanel">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Edit.Installed}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SteamGameCombo" Grid.Column="1" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Steam AppID" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SteamAppIdBox" Grid.Column="1" Padding="6" />
                        </Grid>
                    </StackPanel>

                    <!-- Эмулятор -->
                    <StackPanel x:Name="EmulatorPanel">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Edit.EmulatorExe}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="EmulatorPathBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseEmulatorButton" Grid.Column="2" Content="{DynamicResource Common.Browse}" Appearance="Secondary" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Edit.Rom}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RomPathBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseRomButton" Grid.Column="2" Content="{DynamicResource Common.Browse}" Appearance="Secondary" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Edit.Arguments}" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1">
                                <TextBox x:Name="ArgumentTemplateBox" Padding="6" />
                                <TextBlock Text="{DynamicResource Edit.RomHint}"
                                           Foreground="#888888" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Скрипт -->
                    <StackPanel x:Name="ScriptPanel">
                        <TextBlock Text="{DynamicResource Edit.ScriptLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="ScriptBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" MinHeight="140" Padding="6" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Общие для обычной игры и скрипта -->
                    <Grid x:Name="WorkingDirRow" Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Edit.WorkingDir}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WorkingDirBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                        <ui:Button x:Name="BrowseWorkingDirButton" Grid.Column="2" Content="{DynamicResource Common.Browse}" Appearance="Secondary" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings.Gamepad}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ControllerCombo" Grid.Column="1" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Edit.Picture}" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="CaptureWindowCheck" Grid.Column="1" Foreground="White"
                                  ToolTip="{DynamicResource Edit.CaptureWindowTip}">
                            <TextBlock Text="{DynamicResource Edit.CaptureWindow}" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>

                    <Grid x:Name="RunAsAdminRow" Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Edit.Rights}" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="RunAsAdminCheck" Grid.Column="1" Foreground="White"
                                  ToolTip="{DynamicResource Edit.RunAsAdminTip}">
                            <TextBlock Text="{DynamicResource Edit.RunAsAdmin}" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>
                </StackPanel>

                <!-- Обложка -->
                <StackPanel Grid.Column="1" Width="160">
                    <TextBlock Text="{DynamicResource Edit.Cover}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <Border Width="160" Height="240" CornerRadius="8" Background="#FF2A2A36" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="NoCoverText" Text="{DynamicResource Edit.NoCover}" Foreground="#777777"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <ui:Button x:Name="ChooseCoverButton" Content="{DynamicResource Edit.ChooseCover}" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <ui:Button x:Name="CropCoverButton" Content="{DynamicResource Edit.CropCover}" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="0,6,0,0"
                               ToolTip="{DynamicResource Edit.CropCoverTip}" />
                    <ui:Button x:Name="ClearCoverButton" Content="{DynamicResource Edit.ClearCover}" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <ui:Button x:Name="CancelButton" Content="{DynamicResource Common.Cancel}" Appearance="Secondary" Margin="0,0,8,0" MinWidth="100" />
            <ui:Button x:Name="SaveButton" Content="{DynamicResource Common.Save}" Appearance="Primary" MinWidth="100" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
