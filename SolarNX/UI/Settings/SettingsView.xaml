<UserControl x:Class="SolarNX.UI.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF1A1A24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="PortLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="20,20,20,0">
            <ui:Button x:Name="BackButton" Appearance="Secondary" Margin="0,0,12,0" ToolTip="Назад">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock Text="Настройки" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Подключение -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Подключение" Style="{StaticResource CardHeader}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Режим" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ConnectionModeCombo" Grid.Column="1" />
                        </Grid>
                        <Grid x:Name="InternetPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Привязанные Switch" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PairedDevicesText" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="PairButton" Content="Привязать Switch…" Appearance="Primary" Margin="0,0,8,0" />
                                    <ui:Button x:Name="ForgetDevicesButton" Content="Забыть все" Appearance="Secondary" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="2,10,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="Экспериментальный режим. Без сервера: пробросьте на роутере UDP-порт 19010 на этот компьютер, а на Switch (X в главном меню) выберите Internet и введите внешний адрес ПК. С сервером-посредником проброс не нужен: на Switch укажите сервер и ID этого ПК. Затем один раз привяжите Switch (Pair). Трафик шифруется. Режим применяется при следующем включении трансляции." />
                        </Grid>
                        <Grid x:Name="ServerPanel" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="ID этого ПК" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HostIdBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="15" Padding="8,4" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Text="Сервер-посредник" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1" Padding="8,4" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Text="Ключ сервера" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ServerKeyBox" Grid.Row="2" Grid.Column="1" Padding="8,4" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="2,0,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="Необязательно. Адрес вашего сервера SolarNX Rendezvous (адрес или адрес:порт, по умолчанию порт 19020) и его ключ доступа, если он задан. См. документацию «Сервер для игры через интернет»." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Видео -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Видео" Style="{StaticResource CardHeader}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Разрешение" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ResolutionCombo" Grid.Column="1" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Кадров в секунду" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FpsCombo" Grid.Column="1" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Битрейт (кбит/с)" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox x:Name="BitrateBox" Grid.Column="1" Minimum="1000" Maximum="50000" SpinButtonPlacementMode="Compact" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Адаптивный битрейт" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch x:Name="AdaptiveBitrateToggle" Grid.Column="1" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Кодировщик" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="EncoderCombo" Grid.Column="1" />
                            <TextBlock x:Name="EncoderInfoText" Grid.Row="1" Grid.Column="1" Margin="2,6,0,0"
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="Проверка видеокарты…" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Геймпад -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Геймпад" Style="{StaticResource CardHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Раскладка Switch (A↔B, X↔Y)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <ui:ToggleSwitch x:Name="SwitchLayoutToggle" Grid.Column="1" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="2,6,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="Можно переключать и на Switch: кнопка Y в главном меню. Действует последнее изменение — на ПК или на Switch." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- shadPS4 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="shadPS4" Style="{StaticResource CardHeader}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Путь к shadPS4.exe" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ShadPs4PathBox" Grid.Column="1" IsReadOnly="True" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseShadPs4Button" Grid.Column="2" Content="Обзор…" Appearance="Secondary" />
                        </Grid>

                        <ui:HyperlinkButton x:Name="DownloadShadPs4Link" Content="Скачать shadPS4" Padding="0" />
                    </StackPanel>
                </Border>

                <!-- Драйверы -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Драйверы" Style="{StaticResource CardHeader}" />
                        <ui:Button x:Name="DriversButton" Content="Переустановить драйвер геймпада (ViGEmBus)"
                                   Appearance="Secondary" HorizontalAlignment="Stretch" Height="36" />
                    </StackPanel>
                </Border>

                <!-- Порты: только в dev-режиме, не нужны для обычного использования -->
                <Border x:Name="PortsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Порты" Style="{StaticResource CardHeader}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Видео" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="VideoPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Аудио" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="AudioPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="HID" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="HidPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Библиотека" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="LibraryPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
