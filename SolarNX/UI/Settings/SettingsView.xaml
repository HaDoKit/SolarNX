<UserControl x:Class="SolarNX.UI.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF1A1A24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="PortLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="20,20,20,0">
            <ui:Button x:Name="BackButton" Appearance="Secondary" Margin="0,0,12,0" ToolTip="{DynamicResource Common.Back}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock Text="{DynamicResource Home.Settings}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Язык -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource CardHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.LanguageLabel}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Подключение -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Connection}" Style="{StaticResource CardHeader}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Mode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ConnectionModeCombo" Grid.Column="1" />
                        </Grid>
                        <Grid x:Name="InternetPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.PairedSwitches}" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PairedDevicesText" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="PairButton" Content="{DynamicResource Settings.PairButton}" Appearance="Primary" Margin="0,0,8,0" />
                                    <ui:Button x:Name="ForgetDevicesButton" Content="{DynamicResource Settings.ForgetAll}" Appearance="Secondary" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="2,10,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.InternetHint}" />
                        </Grid>
                        <Grid x:Name="ServerPanel" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.HostId}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HostIdBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="15" Padding="8,4" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Settings.Server}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1" Padding="8,4" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.ServerKey}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ServerKeyBox" Grid.Row="2" Grid.Column="1" Padding="8,4" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="2,0,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.ServerHint}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Видео -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Video}" Style="{StaticResource CardHeader}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Resolution}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ResolutionCombo" Grid.Column="1" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Fps}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FpsCombo" Grid.Column="1" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Bitrate}" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox x:Name="BitrateBox" Grid.Column="1" Minimum="1000" Maximum="50000" SpinButtonPlacementMode="Compact" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.AdaptiveBitrate}" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch x:Name="AdaptiveBitrateToggle" Grid.Column="1" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Encoder}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="EncoderCombo" Grid.Column="1" />
                            <TextBlock x:Name="EncoderInfoText" Grid.Row="1" Grid.Column="1" Margin="2,6,0,0"
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.EncoderChecking}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Codec}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CodecCombo" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="2,6,0,0"
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.CodecHint}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Геймпад -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Gamepad}" Style="{StaticResource CardHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.SwitchLayout}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <ui:ToggleSwitch x:Name="SwitchLayoutToggle" Grid.Column="1" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="2,6,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.SwitchLayoutHint}" />
                            <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="{DynamicResource Settings.Rumble}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <ui:ToggleSwitch x:Name="RumbleToggle" Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="2,6,0,0" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.RumbleHint}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- shadPS4 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="shadPS4" Style="{StaticResource CardHeader}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings.ShadPs4Path}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ShadPs4PathBox" Grid.Column="1" IsReadOnly="True" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseShadPs4Button" Grid.Column="2" Content="{DynamicResource Common.Browse}" Appearance="Secondary" />
                        </Grid>

                        <ui:HyperlinkButton x:Name="DownloadShadPs4Link" Content="{DynamicResource Settings.ShadPs4Download}" Padding="0" />
                    </StackPanel>
                </Border>

                <!-- Драйверы -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Drivers}" Style="{StaticResource CardHeader}" />
                        <ui:Button x:Name="DriversButton" Content="{DynamicResource Settings.ReinstallVigem}"
                                   Appearance="Secondary" HorizontalAlignment="Stretch" Height="36" />
                    </StackPanel>
                </Border>

                <!-- Порты: только в dev-режиме, не нужны для обычного использования -->
                <Border x:Name="PortsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Ports}" Style="{StaticResource CardHeader}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Settings.Video}" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="VideoPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource Settings.PortAudio}" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="AudioPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="HID" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="HidPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource Settings.PortLibrary}" Style="{StaticResource PortLabel}" />
                                <ui:NumberBox x:Name="LibraryPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
