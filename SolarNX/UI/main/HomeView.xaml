<UserControl x:Class="SolarNX.UI.main.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="StartBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFE2A8" Offset="0" />
            <GradientStop Color="#FFFFB24A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StartHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFEBC0" Offset="0" />
            <GradientStop Color="#FFFFC064" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="StartPressedBackground" Color="#FFF0A43C" />
        <SolidColorBrush x:Key="StartForeground" Color="#FF08090D" />
        <SolidColorBrush x:Key="StartBorder" Color="#FFFFD68C" />

        <SolidColorBrush x:Key="StopBackground" Color="#FF14151C" />
        <SolidColorBrush x:Key="StopHoverBackground" Color="#FF221519" />
        <SolidColorBrush x:Key="StopPressedBackground" Color="#FF2E171A" />
        <SolidColorBrush x:Key="StopForeground" Color="#FFFF5A46" />
        <SolidColorBrush x:Key="StopBorder" Color="#FFFF3C28" />
    </UserControl.Resources>
    <Grid>
        <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#D90E0F15" BorderBrush="#40FFD68C" BorderThickness="1"
                CornerRadius="16" Padding="28" MinWidth="360">
            <StackPanel>
                <Image Source="pack://application:,,,/Assets/wordmark.png" Height="40"
                       HorizontalAlignment="Center" Margin="0,-4,0,14"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock x:Name="IpLabel" Text="IP клиента" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IpBox" Grid.Column="0" Padding="8" FontSize="14" Margin="0,0,8,0" />
                    <ui:Button x:Name="LibraryButton" Grid.Column="1" Appearance="Secondary" ToolTip="Библиотека игр" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Games24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="SettingsButton" Grid.Column="2" Appearance="Secondary" ToolTip="Настройки">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <!-- Colours set per state in RefreshStatus (eclipse style: gold to start, dark with a
                     red rim to stop) - see the *Start/*Stop brushes in Resources. -->
                <ui:Button x:Name="ToggleStreamingButton"
                           Content="▶  Включить трансляцию"
                           Appearance="Secondary" BorderThickness="1" FontWeight="SemiBold"
                           HorizontalAlignment="Stretch" Height="44" FontSize="14"
                           Margin="0,0,0,8" />

                <TextBlock x:Name="StatusLabel" Text="Статус: выключено" Foreground="#AAAAAA"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Показать экран" Foreground="White" VerticalAlignment="Center" />
                    <ui:ToggleSwitch x:Name="ShowScreenToggle" Grid.Column="1" IsEnabled="False" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
