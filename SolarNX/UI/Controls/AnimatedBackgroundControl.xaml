<UserControl x:Class="SolarNX.UI.Controls.AnimatedBackgroundControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             ClipToBounds="True">
    <Grid Background="#FF08090D">
        <Image x:Name="SceneImage" Source="pack://application:,,,/Assets/background.png"
               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Canvas x:Name="RootCanvas" />
    </Grid>
</UserControl>
